# Host-facing address of the Nginx frontend.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# PostgreSQL credentials. Change the example password before starting.
POSTGRES_DB=noters
POSTGRES_USER=noters
POSTGRES_PASSWORD=noters_local_password

# Go backend settings.
LOG_LEVEL=INFO
DB_MAX_CONNS=10

# Local authentication. Set Secure cookies to true when serving over HTTPS.
AUTH_SESSION_TTL=24h
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=true
